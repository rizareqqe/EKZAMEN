<Window x:Class="WpfApp1.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="AuthWindow" Height="450" Width="800">
    <Grid Margin="0,10,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="94*"/>
            <ColumnDefinition Width="463*"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="loginTextBox" HorizontalAlignment="Left" Margin="213,158,0,0" TextWrapping="Wrap" Text="Логин" VerticalAlignment="Top" Width="120" Grid.Column="1"/>
        <TextBox x:Name="passwordTextBox" HorizontalAlignment="Left" Margin="213,194,0,0" TextWrapping="Wrap" Text="Пароль" VerticalAlignment="Top" Width="120" Grid.Column="1"/>
        <Button x:Name="authButton" Content="Войти" HorizontalAlignment="Left" Margin="227,232,0,0" VerticalAlignment="Top" Grid.Column="1" Height="24" Width="93" Click="authButton_Click"/>

    </Grid>
</Window>

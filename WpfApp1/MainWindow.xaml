<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <DataGrid x:Name="userTable" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="92,60,92,88" SelectionChanged="userTable_SelectionChanged" ColumnWidth="*" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Id}" Header="Номер"/>
                <DataGridTextColumn Binding="{Binding FullName}" Header="Имя"/>
                <DataGridTextColumn Binding="{Binding Login}" Header="Логин"/>
                <DataGridTextColumn Binding="{Binding Password}" Header="Пароль"/>
            </DataGrid.Columns>
        </DataGrid>
        <Button x:Name="SearchButton" Content="Поиск" HorizontalAlignment="Left" Margin="524,386,0,0" VerticalAlignment="Top" Click="SearchButton_Click"/>
        <TextBox x:Name="SearchBox" HorizontalAlignment="Left" Margin="304,386,0,0" TextWrapping="Wrap" Text="Введи имя" VerticalAlignment="Top" Width="120"/>
        <TextBlock x:Name="authTextBlock" HorizontalAlignment="Left" Margin="727,23,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top"/>

    </Grid>
</Window>
